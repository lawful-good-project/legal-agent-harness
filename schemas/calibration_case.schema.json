{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/calibration_case.schema.json",
  "title": "CalibrationCase",
  "description": "Кейс калибровки правового агента: источник + ожидаемое извлечение.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "source", "expected"],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "description": "Уникальный идентификатор кейса."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "jurisdiction", "doc_type", "identifier", "coordinate"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "string", "minLength": 1},
        "doc_type": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "coordinate": {"type": "string", "minLength": 1},
        "effective_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["norm_id", "predicate", "subject", "object", "confidence"],
      "properties": {
        "norm_id": {"type": "string", "minLength": 1},
        "predicate": {
          "type": "string",
          "minLength": 1,
          "description": "Для amending_act используется канонический тип изменения.",
          "enum": [
            "изменена",
            "дополнена",
            "введена",
            "изложена_в_новой_редакции",
            "признана_утратившей_силу",
            "исключена",
            "уточнена",
            "предоставляет_охрану",
            "отсылает_к",
            "влечёт_изменение",
            "требует_приведения_в_соответствие"
          ]
        },
        "subject": {"type": "string", "minLength": 1},
        "object": {"type": "string", "minLength": 1},
        "effective_from": {"type": ["string", "null"]},
        "effective_to": {"type": ["string", "null"]},
        "change_description": {"type": ["string", "null"], "maxLength": 2000},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    }
  }
}
